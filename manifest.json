{
  "manifest_version": 3,
  "name": "Y2K-ifier",
  "version": "1.0.1",
  "description": "Surgically transforms modern web pages into a 2000s retro aesthetic.",
  "permissions": ["scripting", "storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Y2K-ifier：复古模式",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/retro.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
